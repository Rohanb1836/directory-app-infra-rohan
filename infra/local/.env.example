# Copy to .env. These values are for LOCAL DEVELOPMENT ONLY. Never reuse them in any other environment.
KEYCLOAK_VERSION=26.7.4

POSTGRES_PASSWORD=postgres
APP_DB_PASSWORD=blackpages
KEYCLOAK_DB_PASSWORD=keycloak

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

KEYCLOAK_BFF_CLIENT_SECRET=local-bff-secret-change-me
KEYCLOAK_ADMIN_API_CLIENT_SECRET=local-admin-api-secret-change-me

# The browser reaches the app through the Next.js dev server, which rewrites /api/* to :8080
APP_BASE_URL=http://localhost:3000
BACKCHANNEL_LOGOUT_URL=http://host.docker.internal:8080/logout/connect/back-channel/keycloak
SMTP_FROM=no-reply@blackpages.local
